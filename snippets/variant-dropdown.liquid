{%- liquid
  comment
    Memorabil: o opțiune cu o singură valoare (de ex. „Design”) nu are ce alege, așa că se ascunde.
    Culoarea rămâne vizibilă, ca să se vadă că produsul e alb sau negru.
  endcomment
  assign mem_option_name = option.name | downcase
  assign mem_hide_option = false
  if option.values.size == 1
    unless mem_option_name contains 'culoare' or mem_option_name contains 'color'
      assign mem_hide_option = true
    endunless
  endif
-%}
<div class="variant-wrapper small--text-center variant-wrapper--dropdown js{% if mem_hide_option %} mem-variant--hidden{% endif %}" data-type="dropdown">
  <label class="variant__label{% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    {{ option.name }}
  </label>
  <div class="variant-input-wrap"
    data-index="option{{ forloop.index }}"
    data-handle="{{ option.name | handleize }}">
    <select
      form="{{ form_id }}"
      class="variant__input-{{ section_id }}"
      id="SingleOptionSelector-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}"
      data-index="option{{ forloop.index }}"
      data-variant-input>
      {%- for value in option.values -%}
        {%- liquid
          assign variant_label_state = true
          if product.options.size == 1 and block.settings.product_dynamic_variants_enable
            unless product.variants[forloop.index0].available
              assign variant_label_state = false
            endunless
          endif
        -%}
        <option
          value="{{ value | escape }}"
          {% if option.selected_value == value %} selected="selected"{% endif %}
          {% unless variant_label_state %} disabled="disabled"{% endunless %}
          name="{{ option.name }}"
          class="variant-input"
          data-index="option{{ forloop.index }}">
          {{ value }}
        </option>
      {%- endfor -%}
    </select>
  </div>
</div>
