{%- comment -%}
  Memorabil: tab-uri construite din câmpurile produsului (metafields custom.*), în stilul tab-urilor Streamline.
  Un tab apare doar dacă are conținut, deci produsele fără câmpuri completate nu afișează tab-uri goale.
    Detalii și materiale: material, marime, imprimare, continut, detalii, cod produs
    Îngrijire:            ingrijire (câte o instrucțiune pe rând)
    Siguranța produsului: gpsr_producator, gpsr_contact, gpsr_responsabil_ue, gpsr_avertismente
{%- endcomment -%}
{%- liquid
  assign mf = product.metafields.custom
  assign current_variant = product.selected_or_first_available_variant
-%}

{%- capture details -%}
  {%- if mf.material != blank -%}<div class="mem-row"><dt>Material</dt><dd>{{ mf.material | escape }}</dd></div>{%- endif -%}
  {%- if mf.marime != blank -%}<div class="mem-row"><dt>Mărime și croială</dt><dd>{{ mf.marime | escape }}</dd></div>{%- endif -%}
  {%- if mf.imprimare != blank -%}<div class="mem-row"><dt>Imprimare</dt><dd>{{ mf.imprimare | escape }}</dd></div>{%- endif -%}
  {%- if mf.continut != blank -%}<div class="mem-row"><dt>În pachet</dt><dd>{{ mf.continut | escape }}</dd></div>{%- endif -%}
  {%- if mf.detalii != blank -%}
    <div class="mem-row mem-row--list"><dt>Detalii</dt><dd><ul>
      {%- assign lines = mf.detalii.value | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}{%- endfor -%}
    </ul></dd></div>
  {%- endif -%}
  {%- if current_variant.sku != blank -%}<div class="mem-row"><dt>Cod produs</dt><dd>{{ current_variant.sku | escape }}</dd></div>{%- endif -%}
{%- endcapture -%}
{%- liquid
  assign has_details = false
  if mf.material != blank or mf.marime != blank or mf.imprimare != blank
    assign has_details = true
  endif
  if mf.continut != blank or mf.detalii != blank
    assign has_details = true
  endif
-%}
{%- if has_details -%}
  {%- capture content -%}<dl class="mem-list">{{ details }}</dl>{%- endcapture -%}
  <div class="product-block product-block--tab" {{ block.shopify_attributes }}>
    {%- render 'tab', id: 'mem-details', title: 'Detalii și materiale', content: content -%}
  </div>
{%- endif -%}

{%- if mf.ingrijire != blank -%}
  {%- capture content -%}
    <ul class="mem-care">
      {%- assign lines = mf.ingrijire.value | newline_to_br | split: '<br />' -%}
      {%- for line in lines -%}{%- assign l = line | strip -%}{%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}{%- endfor -%}
    </ul>
  {%- endcapture -%}
  <div class="product-block product-block--tab">
    {%- render 'tab', id: 'mem-care', title: 'Îngrijire', content: content -%}
  </div>
{%- endif -%}

{%- if mf.gpsr_producator != blank -%}
  {%- capture content -%}
    <dl class="mem-list">
      <div class="mem-row"><dt>Producător</dt><dd>{{ mf.gpsr_producator | escape | newline_to_br }}</dd></div>
      {%- if mf.gpsr_contact != blank -%}<div class="mem-row"><dt>Contact</dt><dd>{{ mf.gpsr_contact | escape }}</dd></div>{%- endif -%}
      {%- if mf.gpsr_responsabil_ue != blank -%}<div class="mem-row"><dt>Persoană responsabilă în UE</dt><dd>{{ mf.gpsr_responsabil_ue | escape | newline_to_br }}</dd></div>{%- endif -%}
      {%- if mf.gpsr_avertismente != blank -%}<div class="mem-row"><dt>Avertismente</dt><dd>{{ mf.gpsr_avertismente | escape | newline_to_br }}</dd></div>{%- endif -%}
    </dl>
  {%- endcapture -%}
  <div class="product-block product-block--tab">
    {%- render 'tab', id: 'mem-safety', title: 'Siguranța produsului', content: content -%}
  </div>
{%- endif -%}
