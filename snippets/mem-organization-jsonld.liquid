{%- comment -%}
  Memorabil: datele structurate ale magazinului pentru Google (Organization), doar pe prima pagină.
  Sloganul și brand statement-ul sunt cele din CLAUDE.md.
{%- endcomment -%}
{%- liquid
  assign org_url = request.origin | append: '/'
  assign org_logo = shop.brand.logo
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | strip | json }},
  "legalName": "MEMORABIL MEDIA S.R.L.",
  "url": {{ org_url | json }},
  "slogan": "Replici care se poartă.",
  "description": "Tricouri, hanorace, căni și tote bags cu replici în română, imprimate la comandă în București. Pentru că nu ne stă bine să tăcem."
  {%- if org_logo != blank -%},
  "logo": {{ org_logo | image_url: width: 600 | prepend: 'https:' | json }}
  {%- endif %}
}
</script>
