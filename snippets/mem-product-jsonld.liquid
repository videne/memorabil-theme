{%- comment -%}
  Memorabil: date structurate pentru Google (schema.org Product), cu preț pe variantă, stoc, livrare, retur și recenzii.
  Înlocuiește blocul JSON-LD original din product-template-variables.liquid.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign valid_until = 'now' | date: '%s' | plus: 2592000 | date: '%Y-%m-%d'
  assign brand_name = product.vendor | default: shop.name
  assign production = settings.mem_production_days | default: 3
  assign transit = settings.mem_transit_days | default: 2
  assign ship_cost = settings.mem_shipping_cost | default: 20
  assign return_days = settings.mem_return_days | default: 14
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    "description": {{ product.description | strip_html | strip_newlines | truncate: 5000 | json }},
    "sku": {{ current_variant.sku | json }},
    "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
    {%- if product.type != blank -%}"category": {{ product.type | json }},{%- endif -%}
    {%- if product.media.size > 0 -%}
      "image": [
        {%- for media in product.media limit: 6 -%}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
    {%- endif -%}
    {%- if rating != blank and rating_count > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ rating.rating | json }},
        "bestRating": {{ rating.scale_max | json }},
        "worstRating": {{ rating.scale_min | json }},
        "ratingCount": {{ rating_count | json }}
      },
    {%- endif -%}
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          {%- assign bc_size = variant.barcode | size -%}
          {%- if bc_size == 8 or bc_size == 12 or bc_size == 13 or bc_size == 14 -%}"gtin": {{ variant.barcode | json }},{%- endif -%}
          {%- if product.has_only_default_variant == false -%}"name": {{ variant.title | json }},{%- endif -%}
          "url": {{ request.origin | append: variant.url | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "priceValidUntil": "{{ valid_until }}",
          "itemCondition": "https://schema.org/NewCondition",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "RO" },
            "shippingRate": { "@type": "MonetaryAmount", "value": {{ ship_cost | json }}, "currency": {{ cart.currency.iso_code | json }} },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": {{ production }}, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": {{ transit }}, "unitCode": "DAY" }
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "RO",
            "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
            "merchantReturnDays": {{ return_days }},
            "returnMethod": "https://schema.org/ReturnByMail"
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
