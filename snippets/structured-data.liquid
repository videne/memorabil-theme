{%- comment -%}
  Structured data (JSON-LD) pentru SEO — adăugat pentru memorabil.ro
  - Homepage: Organization + WebSite (cu SearchAction pentru sitelinks search box în Google)
  - Colecții: BreadcrumbList + CollectionPage
  - Produse: BreadcrumbList (schema de Product există deja în product-template-variables)
{%- endcomment -%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    {%- if settings.logo != blank -%}
    "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},
    {%- endif -%}
    "sameAs": [
      {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link | json }}{%- endif -%}
      {%- if settings.social_facebook_link != blank -%}{%- if settings.social_instagram_link != blank -%},{%- endif -%}{{ settings.social_facebook_link | json }}{%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}{%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank -%},{%- endif -%}{{ settings.social_tiktok_link | json }}{%- endif -%}
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'collection' and collection != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Acasă",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    ]
  }
  </script>
{%- endif -%}

{%- if request.page_type == 'product' and product != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Acasă",
        "item": {{ shop.url | json }}
      }
      {%- if collection != blank -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- else -%}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    ]
  }
  </script>
{%- endif -%}
